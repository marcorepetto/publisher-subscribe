# URL de conexión AMQP (CloudAMQP o RabbitMQ local)
# Ejemplo CloudAMQP: amqps://usuario:password@host.cloudamqp.com/vhost
# Ejemplo Local: amqp://guest:guest@localhost:5672/
CLOUDAMQP_URL=amqp://guest:guest@localhost:5672/

# Nombre del exchange de eventos sísmicos
EXCHANGE_NAME=sismos_events

# URL base del servicio HTTP de datos detallados de sismos
HTTP_SERVICE_URL=http://localhost:8000
